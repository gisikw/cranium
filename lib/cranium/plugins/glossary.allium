-- allium: 3

-- Glossary System (Macro-based)
--
-- First-mention glossary injection and conversational auto-update,
-- implemented as cranium macros rather than a bespoke plugin.
--
-- Each glossary entry is an independent macro definition (JSON) in
-- ~/Projects/hoard/macros/glossary/. The macro engine handles loading,
-- pattern matching, first-mention tracking, injection, and epoch-end
-- revision — all through standard macro axes rather than custom code.
--
-- Scope: Entry definition, first-mention injection, extended lookup,
-- epoch-end auto-update via macro revision. Entry creation guided by
-- the macro-creator skill macro.
--
-- Depends on: macro-engine (Registry, Trigger, Matcher, Executor,
--             Revision, State)

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value GlossaryMacro {
    name: String
        -- "glossary-<term>". Prefixed to avoid collisions with
        -- other macros. The term portion matches the filename.
    description: String
        -- One-line summary. Also serves as the base content for
        -- the prompt injection.
    patterns: [String]
        -- Match patterns: canonical term + aliases. Literal strings
        -- get word-boundary wrapping, case-insensitivity, and
        -- hyphen/space interchangeability from Matcher.
    prompt_text: String
        -- Formatted injection content:
        -- "- **Display Name**: summary text"
        -- Wrapped in <glossary> tags at priority 15.

    @guidance
        -- Each entry is a standalone JSON file in
        -- ~/Projects/hoard/macros/glossary/<term>.json.
        -- The Registry scans recursively and hot-reloads on
        -- file changes. No central index or manifest needed.
}

------------------------------------------------------------
-- Macro Axis Configuration
------------------------------------------------------------

config GlossaryAxes {
    trigger: match
        -- Fires when any pattern matches the user's message.
    match_once: true
        -- First mention only per session. The Trigger module
        -- tracks fired macros in a per-room seen-set (MapSet).
    advertising: hidden
        -- Not exposed as a tool. Injection-only.
    lifecycle: session
        -- Resets on epoch clear — terms become re-injectable.
    learning: none
        -- No sidecar evaluation during the session.
    revision: session_end
        -- At epoch end, the Revision module dispatches async
        -- revision to a sidecar model for any glossary macro
        -- that fired during the session.
    disposition: foreground
        -- Injection happens synchronously during context build.

    prompt_tag: "glossary"
    prompt_priority: 15
        -- Between time-gap (10) and landscape (20).

    @guidance
        -- The "once" tracking uses the macro engine's session
        -- state (State.get_session/1 → :seen MapSet), not a
        -- custom seen map. Version bumps on the macro definition
        -- reset the seen state, enabling re-injection after
        -- content changes — replacing the old mtime-based
        -- re-injection logic.
}

------------------------------------------------------------
-- Rules: Injection
------------------------------------------------------------

rule InjectOnFirstMention {
    when: Trigger.evaluate matches a glossary macro

    requires: macro.name not in session seen-set
        (or version changed since last seen)

    ensures: injection with formatted glossary content
        wrapped in <glossary> tags at priority 15
    ensures: macro.name added to session seen-set

    @guidance
        -- Multiple glossary terms matched on the same turn
        -- produce separate <glossary> injections (one per macro).
        -- This differs from the old plugin which combined them
        -- into a single block, but is functionally identical
        -- for the model.
        --
        -- Pattern matching uses Matcher.compile_literal/1:
        -- word boundaries, case-insensitive, hyphen/space
        -- interchangeable. Patterns like "brian" match "Brian"
        -- but not "briant" (word boundary).
}

------------------------------------------------------------
-- Rules: Lookup
------------------------------------------------------------

rule LookupGlossaryEntry {
    when: agent invokes glossary-lookup tool with term

    let term = lowercase(input.term)
    let file = ~/Projects/hoard/macros/glossary/{term}.json

    ensures: full macro definition JSON returned as tool result
        when file exists
    ensures: case-insensitive partial match attempted when exact
        match fails
    ensures: available entries listed when no match found

    @guidance
        -- The glossary-lookup macro is a separate explicit-trigger
        -- macro (script body) that reads the JSON definition file.
        -- It returns the full definition, not just the summary —
        -- the agent can extract extended context from the
        -- prompt_body.text field.
        --
        -- The macro declares input_schema with a required "term"
        -- parameter, so the model sends {"term": "Zayna"} and
        -- the executor exports it as MACRO_TERM. The script
        -- lowercases the term for case-insensitive file matching
        -- and falls back to find -iname for partial matches.
}

------------------------------------------------------------
-- Rules: Auto-Update (epoch end)
------------------------------------------------------------

rule ReviseAtEpochEnd {
    when: Engine.on_epoch_end is called

    requires: macro.revision = session_end
    requires: macro.name in session seen-set
        -- Match-triggered macros don't set "active" state like
        -- condition macros. The engine checks the seen-set for
        -- match macros with revision=session_end.

    ensures: Revision.dispatch called with full conversation

    @guidance
        -- The Revision module sends the complete conversation
        -- and current macro definition to a sidecar model
        -- (default: gemma4 via Ollama). This replaces the old
        -- plugin's windowed-excerpt approach — sending the full
        -- conversation is simpler and works well with capable
        -- local models.
        --
        -- The revision prompt instructs the model to only update
        -- the description and prompt_body.text fields, preserving
        -- all other macro configuration. Updates are atomic
        -- (tmp+rename) with automatic version bump.
}

rule ApplyRevision {
    when: sidecar model returns {"update": true, "definition": ...}

    requires: revised definition passes Definition.parse validation

    ensures: macro JSON file atomically rewritten
    ensures: version incremented
    ensures: _revision_history appended with timestamp and rationale
    ensures: Registry.reload triggered

    @guidance
        -- The validation gate prevents malformed revisions from
        -- corrupting the macro. If the model produces invalid
        -- JSON or a definition that fails parsing, the revision
        -- is logged and discarded.
        --
        -- The _revision_history array provides auditability,
        -- replacing the old HTML comment changelog in markdown
        -- files.
}

------------------------------------------------------------
-- Rules: Entry Creation
------------------------------------------------------------

rule CreateGlossaryEntry {
    when: user requests a new glossary entry

    ensures: macro-creator tool invoked with glossary archetype

    @guidance
        -- The macro-creator skill macro includes a glossary
        -- archetype template with the correct axis configuration,
        -- file location, pattern format, and revision prompt.
        -- New entries are created by writing a JSON file to
        -- ~/Projects/hoard/macros/glossary/<term>.json.
        -- Hot-reload picks it up automatically.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant FirstMentionOnly {
    for session in Sessions:
        a glossary macro injects at most once per session
        unless the macro version changes mid-session

    @guidance
        -- Enforced by Trigger.evaluate via the session seen-set.
        -- The once flag is per-macro, per-room. Version changes
        -- reset the seen state for that macro.
}

invariant RevisionNonBlocking {
    for epochs in Epochs:
        revision failures do not prevent epoch clearing

    @guidance
        -- Revision.dispatch runs in Task.start (fire-and-forget).
        -- If Ollama is unreachable, the model times out, or the
        -- revised definition fails validation, the error is
        -- logged and the original definition is preserved.
}

invariant RevisionPreservesStructure {
    for revisions in Revisions:
        only description and prompt_body.text are modified
        all other macro fields are preserved exactly

    @guidance
        -- Enforced by the revision prompt, not programmatically.
        -- The model is instructed to only update summary content
        -- and preserve all configuration. The Definition.parse
        -- validation provides a safety net — if critical fields
        -- are altered in a way that breaks parsing, the revision
        -- is rejected.
}

invariant AtomicFileWrite {
    for writes in file writes:
        glossary macro files are written atomically
        (write to temp, rename)

    @guidance
        -- Inherited from Revision.atomic_write/2. Prevents
        -- partial writes from corrupting macro definitions.
}
