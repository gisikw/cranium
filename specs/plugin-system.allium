-- allium: 3

-- Plugin System
--
-- How cranium discovers, loads, configures, and orchestrates plugins.
-- Plugins are session-scoped GenServers that subscribe to hook points in
-- the conversation lifecycle. They observe turns, maintain their own state,
-- and optionally inject content into the context pipeline.
--
-- Scope: Plugin registration, lifecycle, hook dispatch, injection contract,
-- profile routing, hot code reload. Does NOT cover the implementation of
-- specific plugins (glossary, ensemble, etc.) — those are separate specs.
-- Does NOT cover inference internals, transport, or media pipeline.
--
-- Depends on: conversation-lifecycle.allium (Epoch, Pass, Message)
--             context-system.allium (AssembleTurn, injection pipeline)

use conversation_lifecycle
use context_system

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Profile {
    -- Resolved from profiles.yaml by Config module.
    -- Managed by the profile/config spec.
    plugins: [PluginDeclaration]
}

external entity Supervisor {
    -- OTP supervisor managing plugin GenServer processes.
    -- Standard BEAM supervision — not specified here.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    plugin_beam_path: String
        -- Filesystem path where plugin .beam files are loaded from.
        -- Plugins compiled as separate projects place their artifacts here.
        -- Cranium adds this to the code server's load path at boot.
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value PluginDeclaration {
    module: Atom
    config: Map?

    @guidance
        -- Declared per-profile in profiles.yaml. Module is the Elixir
        -- module name (e.g., Cranium.Plugins.Gloss). Config is an
        -- optional map passed to the plugin's init alongside session
        -- metadata. Shape is plugin-defined — cranium does not validate it.
}

value SessionMetadata {
    conversation_id: String
    epoch_id: String
    room_name: String
    profile: Profile
    plugin_config: Map?

    @guidance
        -- Passed to the plugin's init/1. plugin_config is the config
        -- map from the PluginDeclaration, or nil if none was declared.
}

value TurnContext {
    conversation_id: String
    epoch_id: String
    turn_count: Integer
    message_text: String

    @guidance
        -- Lightweight metadata passed to hook callbacks. Contains the
        -- current user message and turn identifiers. Plugins that need
        -- historical context maintain their own lookback state — cranium
        -- does not materialize history into TurnContext.
}

value EpochEndContext {
    conversation_id: String
    epoch_id: String
    messages: [Message]

    @guidance
        -- Passed to on_epoch_end callbacks when an epoch is closing.
        -- Includes the full message history for the epoch so plugins
        -- can perform end-of-session work (e.g., scanning conversation
        -- for glossary updates, generating per-plugin summaries).
        --
        -- Messages are ordered chronologically (oldest first).
}

value PassCompleteContext {
    conversation_id: String
    epoch_id: String
    output: String
    turn_count: Integer

    @guidance
        -- Passed to after_pass_complete callbacks after inference.
        -- Contains the assistant's output text and the turn count
        -- (already incremented from the user's turn). Plugins use
        -- this for observation/bookkeeping (e.g., tracking which
        -- glossary terms the assistant mentioned so corrections
        -- in subsequent user messages are captured by windowing).
}

value Injection {
    priority: Integer
    content: String

    @guidance
        -- A single injection to be inserted into the turn's injection
        -- pipeline. Priority determines ordering relative to other
        -- injections (both builtin and plugin-provided). Lower numbers
        -- appear earlier in the final prefix.
        --
        -- Content is pre-tagged by the plugin — cranium does not wrap it.
        -- Plugins are responsible for their own XML tags (e.g.,
        -- <system-reminder>, <glossary>, etc.).
        --
        -- Reference priorities for builtins:
        --   time-gap / fresh-time: 10
        --   landscape: 20
        --   saturation: 30
        --   interrupted-context: 40
        --
        -- Ties in priority are resolved in arbitrary order.
}

value ResolvedProfileContext {
    conversation_id: String
    epoch_id: String
    turn_count: Integer
    profile_name: String
    backend: BackendType
    backend_module: Atom
    model: String
    identity: String?
    thinking: Boolean?
    context_window: Integer?
    saturation_warn: Float?
    saturation_critical: Float?

    @guidance
        -- Passed to after_resolve_profile callbacks. Contains the
        -- fully resolved profile metadata that would be used for
        -- this pass's inference. Plugins may return a modified copy
        -- to override routing — typically by resolving a different
        -- profile and substituting its fields.
        --
        -- conversation_id, epoch_id, and turn_count are contextual
        -- inputs — modifying them has no effect. The mutable fields
        -- are: profile_name, backend, backend_module, model, identity,
        -- thinking, context_window, saturation_warn, saturation_critical.
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Plugin {
    module: Atom
    state: any
    subscribed_hooks: [HookPoint]
    session_metadata: SessionMetadata

    @guidance
        -- A plugin is a GenServer process, one instance per session
        -- where it opts in. Supervised by cranium — crashes are
        -- non-fatal to the turn. The supervisor restarts the plugin;
        -- the current turn proceeds without that plugin's contribution.
}

------------------------------------------------------------
-- Hook Points
------------------------------------------------------------

-- Hook points are named lifecycle events that plugins can subscribe to.
-- Each hook point defines a callback signature (what the plugin receives
-- and what it returns). before_context_build and on_epoch_end are fully
-- specified; the others are declared as future extension points.

enum HookPoint {
    after_resolve_profile
    before_context_build
    after_pass_complete
    on_epoch_start
    on_epoch_end

    @guidance
        -- Listed in lifecycle order:
        --
        -- after_resolve_profile: Fires after profile resolution in
        --   TurnAssembler, before system prompt assembly. Receives
        --   ResolvedProfileContext, returns a (potentially modified)
        --   ResolvedProfileContext. This is the plugin's opportunity
        --   to override routing — swapping backend, model, identity,
        --   or the entire profile for this pass. Composable: when
        --   multiple plugins subscribe, each receives the output of
        --   the previous, in plugin declaration order.
        --
        -- before_context_build: Fires after history assembly, before
        --   the injection pipeline runs. The plugin's opportunity to
        --   contribute content to the turn's system-reminder prefix.
        --
        -- after_pass_complete: Fires after inference completes and the
        --   assistant response is persisted. Receives the output text
        --   and turn count. Plugins can update their state (e.g.,
        --   tracking entity mentions in assistant responses). Returns
        --   {:ok, new_state}.
        --
        -- on_epoch_start: Fires when a new epoch is created. Distinct
        --   from plugin init — init fires on process start (which may
        --   be a restart mid-epoch), on_epoch_start fires once per epoch.
        --   Not yet specified.
        --
        -- on_epoch_end: Fires when an epoch is clearing. Receives
        --   EpochEndContext with the full message history for the epoch.
        --   Plugins use this for end-of-session side effects (updating
        --   glossary entries, writing summaries, etc.). Fires before
        --   plugin processes are stopped and before handoff generation.
        --   Return value is ignored — this is a side-effect-only hook.
}

------------------------------------------------------------
-- Rules: Plugin Lifecycle
------------------------------------------------------------

rule StartPlugins {
    when: Epoch.created(conversation_id) or Plugin process restarted

    for decl in profile.plugins:
        let metadata = SessionMetadata(
            conversation_id,
            epoch_id,
            room_name,
            profile,
            plugin_config: decl.config
        )

        -- Start GenServer with metadata.
        -- Plugin init returns one of:
        --   {:ok, subscribed_hooks, state} — plugin opts in
        --   :ignore — plugin declines this session

    ensures: Plugin.created(module: decl.module, subscribed_hooks, state)
        when init returns {:ok, subscribed_hooks, state}
    ensures: no Plugin process exists for decl.module
        when init returns :ignore

    @guidance
        -- Each plugin declared in the profile gets a start attempt.
        -- The plugin inspects SessionMetadata in its init and decides
        -- whether to participate. An empty subscribed_hooks list is
        -- valid but pointless — prefer :ignore for full opt-out.
        --
        -- On mid-session process restart (crash recovery), init is
        -- called again with the same SessionMetadata. The plugin
        -- loses its accumulated state. This is the standard OTP
        -- trade-off — plugins that need durable state should persist
        -- it externally.
}

rule StopPlugins {
    when: Epoch ends for conversation_id

    requires: DispatchOnEpochEnd has completed for conversation_id

    for p in Plugins where p.session_metadata.conversation_id = conversation_id:
        ensures: p is terminated gracefully

    @guidance
        -- Plugin GenServers are session-scoped. When the epoch ends
        -- (either via !clear or natural session close), all plugins
        -- for that conversation are stopped.
        --
        -- Ordering: on_epoch_end hooks fire BEFORE plugin termination,
        -- so plugins still have their state when the hook runs.
}

------------------------------------------------------------
-- Rules: Hook Dispatch
------------------------------------------------------------

rule DispatchAfterResolveProfile {
    when: ProfileResolved(conversation_id, epoch_id, turn_count, resolved)

    let plugins = active Plugins
        where after_resolve_profile in subscribed_hooks
        and session_metadata.conversation_id = conversation_id
        ordered by declaration order in profile.plugins

    let context = ResolvedProfileContext(
        conversation_id,
        epoch_id,
        turn_count,
        profile_name: resolved.profile_name,
        backend: resolved.backend,
        backend_module: resolved.backend_module,
        model: resolved.model,
        identity: resolved.identity,
        thinking: resolved.thinking,
        context_window: resolved.context_window,
        saturation_warn: resolved.saturation_warn,
        saturation_critical: resolved.saturation_critical
    )

    -- Sequential, composable dispatch: each plugin transforms the context
    for p in plugins:
        let context = invoke p.after_resolve_profile(context)
        -- context is returned as {:ok, ResolvedProfileContext, new_state}

    ensures: final context is used for system prompt assembly and inference
    ensures: turn proceeds with original resolved profile when all plugins
        return the context unchanged
    ensures: turn proceeds normally when a plugin crashes during invocation
        (context reverts to last successful output, or original if first)

    @guidance
        -- Unlike other hooks, after_resolve_profile is composable:
        -- plugins are invoked sequentially in declaration order, and
        -- each receives the output of the previous plugin. This allows
        -- independent concerns (ensemble routing, failover, A/B testing)
        -- to layer without coordination.
        --
        -- Declaration order is the order plugins appear in the profile's
        -- plugins list in profiles.yaml. This is deterministic and
        -- controllable by the operator.
        --
        -- Fires in TurnAssembler after resolve_profile() but before
        -- SystemPrompt.contribute(). This timing means the identity
        -- override takes effect for system prompt assembly — a plugin
        -- that swaps the profile gets the alternate's full identity
        -- document, not just steering injections.
        --
        -- If a plugin crashes during invocation, the context reverts
        -- to the last successful output (or the original resolved
        -- profile if the first plugin crashes). Subsequent plugins
        -- in the chain still run against the recovered context.
}

rule DispatchBeforeContextBuild {
    when: AssembleTurn(conversation_id, epoch_id, turn_count, message_text)

    let plugins = active Plugins
        where before_context_build in subscribed_hooks
        and session_metadata.conversation_id = conversation_id

    let turn_context = TurnContext(
        conversation_id,
        epoch_id,
        turn_count,
        message_text
    )

    for p in plugins:
        let result = invoke p.before_context_build(turn_context)
        -- result is :skip or [Injection]

    let all_injections = flatten(results where result != :skip)

    ensures: all_injections are merged into the turn injection pipeline
        ordered by priority alongside builtin injections
    ensures: turn proceeds normally when a plugin crashes during invocation
    ensures: turn proceeds normally when all plugins return :skip

    @guidance
        -- Plugins are invoked sequentially in arbitrary order. Each
        -- plugin receives the same TurnContext — plugins do not see
        -- each other's injections.
        --
        -- If a plugin's GenServer has crashed and is restarting, it
        -- is simply absent from the dispatch list for that turn.
        -- The supervisor restart happens asynchronously.
        --
        -- The injections returned by plugins are merged with the
        -- builtin injections (time-gap, landscape, saturation,
        -- interrupted-context) and sorted by priority. The result
        -- is the final injection prefix for the turn.
}

rule DispatchAfterPassComplete {
    when: Pass.completed(conversation_id, epoch_id, output, turn_count)
        and output is non-empty
        and pass is not ephemeral

    let plugins = active Plugins
        where after_pass_complete in subscribed_hooks
        and session_metadata.conversation_id = conversation_id

    let pass_complete_context = PassCompleteContext(
        conversation_id,
        epoch_id,
        output,
        turn_count
    )

    for p in plugins:
        let {:ok, new_state} = invoke p.after_pass_complete(pass_complete_context)
        -- Plugin state is updated with the new state.

    ensures: plugin state is updated before the next turn's before_context_build
    ensures: turn pipeline proceeds normally when a plugin crashes during invocation

    @guidance
        -- Fires from PassReactor after the assistant message is persisted
        -- to the Store. This ordering is intentional: the message is already
        -- in history when the hook fires, so plugins can rely on the Store
        -- being consistent.
        --
        -- Primary use case: glossary plugin scanning assistant output for
        -- entity mentions, so corrections to stale data in subsequent user
        -- messages are captured by the epoch-end windowing even when the
        -- user's reply uses pronouns instead of entity names.
        --
        -- Unlike before_context_build, this hook does NOT produce injections.
        -- It is state-updating only.
}

rule DispatchOnEpochEnd {
    when: EpochCleared(conversation_id, epoch_id, source)

    let plugins = active Plugins
        where on_epoch_end in subscribed_hooks
        and session_metadata.conversation_id = conversation_id

    let messages = Messages where epoch_id = epoch_id
        ordered by inserted_at asc

    let epoch_end_context = EpochEndContext(
        conversation_id,
        epoch_id,
        messages
    )

    for p in plugins:
        invoke p.on_epoch_end(epoch_end_context)
        -- Return value is ignored. This hook is for side effects only.

    ensures: all subscribed plugins are invoked before handoff generation
    ensures: all subscribed plugins are invoked before plugin processes stop
    ensures: epoch clearing proceeds normally when a plugin crashes during invocation
    ensures: epoch clearing proceeds normally when a plugin times out

    @guidance
        -- Fires synchronously in the epoch clear path, after the epoch
        -- is marked cleared but before handoff generation starts and
        -- before plugin GenServers are terminated. This ordering is
        -- intentional: plugins still have their accumulated session state
        -- (e.g., which terms were mentioned) and can read conversation
        -- history to perform end-of-session work.
        --
        -- The timeout per plugin should be generous (longer than
        -- before_context_build) since epoch-end work may involve
        -- LLM calls or disk writes. But it must still be bounded
        -- to prevent epoch clearing from hanging indefinitely.
        --
        -- Plugin crashes or timeouts are logged and swallowed —
        -- they must not prevent epoch clearing or handoff generation.
}

------------------------------------------------------------
-- Rules: Hot Code Reload
------------------------------------------------------------

rule ReloadPlugin {
    when: plugin module code changes on disk

    ensures: next hook invocation for that plugin runs the new code
    ensures: plugin GenServer state is preserved across reload
    ensures: active sessions are not interrupted

    @guidance
        -- This is standard BEAM hot code swapping. When a new version
        -- of a plugin module is loaded into the code server, the
        -- GenServer's next callback invocation automatically runs the
        -- new code. No process restart. No state loss.
        --
        -- Cranium's responsibility is limited to ensuring the
        -- plugin_beam_path is on the code server's load path at boot.
        -- The actual reload trigger (file watcher, gitops, manual
        -- command) is a deployment concern, not specified here.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant PluginCrashNonFatal {
    for t in Turns:
        a plugin crash during hook invocation does not prevent
        the turn from proceeding to inference

    @guidance
        -- The turn assembler catches plugin invocation failures and
        -- logs them. The failed plugin's contribution is simply
        -- absent from that turn's injection set. The supervisor
        -- restarts the plugin independently.
}

invariant PluginIsolation {
    for p1, p2 in Plugins where p1 != p2:
        p1 cannot observe p2's internal state

    @guidance
        -- Plugins are independent GenServers. They do not share state.
        -- For additive hooks (before_context_build, on_epoch_end),
        -- each plugin receives the same context from cranium and
        -- produces results independently. Ordering is arbitrary.
        --
        -- Exception: after_resolve_profile is intentionally composable.
        -- Each plugin receives the transformed output of the previous
        -- plugin. This is a deliberate design choice — routing transforms
        -- are naturally layerable (ensemble, failover, A/B testing).
        -- Plugins still cannot observe each other's internal state;
        -- they only see the shared ResolvedProfileContext as it flows
        -- through the chain.
}

invariant InjectionOrderDeterministic {
    for t in Turns:
        injections (builtin and plugin) are ordered by priority,
        with ties broken arbitrarily but consistently within a turn

    @guidance
        -- The injection pipeline produces a single ordered list from
        -- all sources. Priority is the sole ordering key. This extends
        -- the InjectionOrderIsFixed invariant from context-system.allium
        -- to include plugin-provided injections.
}

invariant EpochEndBeforeTermination {
    for c in Conversations:
        when epoch clears for c,
        on_epoch_end hooks complete before plugin GenServers are terminated

    @guidance
        -- Plugins need their accumulated session state during on_epoch_end
        -- (e.g., glossary plugin needs its seen-terms set to know which
        -- entries to check for updates). Terminating before the hook fires
        -- would destroy that state. The clear path must dispatch the hook
        -- synchronously before stopping the ConversationSupervisor.
}

invariant HotReloadStatePreservation {
    for p in Plugins:
        when p's module code is reloaded,
        p's GenServer state is preserved

    @guidance
        -- Standard OTP guarantee. The GenServer process continues
        -- with its existing state; only the callback code changes.
        -- Plugins that need state migration across code versions
        -- should implement code_change/3.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Plugin ordering within additive hooks" {
    -- For additive hooks (before_context_build, on_epoch_end),
    -- plugins are invoked in arbitrary order. If a use case arises
    -- where plugin A's injection must inform plugin B's decision,
    -- we may need an explicit ordering mechanism.
    --
    -- For composable hooks (after_resolve_profile), ordering is
    -- already defined: declaration order in the profile's plugins
    -- list. This works because the operator controls the list and
    -- can reason about the transform chain.
}

open question "Plugin-to-plugin communication" {
    -- Plugins are currently fully isolated. If two plugins need
    -- to coordinate (e.g., agenda consults gloss for term
    -- definitions), should there be a sanctioned channel? Or
    -- should such coordination be handled by merging the plugins?
    -- Deferred until a concrete use case arises.
}

open question "Builtin migration to plugin contract" {
    -- The four builtin injectors (time-gap, landscape, saturation,
    -- interrupted-context) could be reimplemented as plugins. This
    -- would validate the plugin contract and simplify cranium's core.
    -- The migration is mechanical once the contract is proven with
    -- a real external plugin (gloss). Deferred until then.
}
