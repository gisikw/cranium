# Database
DATABASE_URL=postgres://user:password@localhost:5432/cranium_prod

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# STT/TTS service URLs
STT_URL=http://stt-host:8787/transcribe
TTS_URL=https://tts-host/v1/audio/speech

# Connection pool
POOL_SIZE=10

# Paths
HANDOFFS_PATH=/path/to/handoffs
SUMMARIES_PATH=/path/to/summaries
SKILLS_PATH=/path/to/skills
IDENTITY_PATH=/path/to/identity.md
SUBAGENT_PROMPT_PATH=/path/to/subagent-prompt.md
# Suppressed-thought journal (defaults to ~/.local/state/cranium/suppressed.jsonl)
SUPPRESSION_JOURNAL_PATH=/path/to/suppressed.jsonl
