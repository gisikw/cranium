# Cranium profile configuration
# Copy to ~/.config/cranium/profiles.yaml (or $XDG_CONFIG_HOME/cranium/profiles.yaml)
#
# Each profile bundles: backend (which adapter), model (which model on that backend),
# and identity (system prompt file path — optional).
#
# Backends: claudecode, anthropic, ollama, openai_compat
#
# The model string is backend-specific. For Ollama, this is the Ollama model name
# (including custom Modelfiles). Model-specific params (temperature, context window,
# sampling) live in Ollama Modelfiles, not here.

default: exo

ollama_url: http://localhost:11434

profiles:
  exo:
    backend: claudecode
    model: claude-opus-4-6
    identity: /path/to/identity.md

  exo-local:
    backend: ollama
    model: gemma4-cranium
    identity: /path/to/identity.md

  exo-api:
    backend: anthropic
    model: claude-opus-4-6
    identity: /path/to/identity.md

  exo-ensemble:
    backend: anthropic
    model: claude-opus-4-6
    identity: /path/to/identity.md
    plugins:
      - module: Cranium.Plugins.Ensemble
        config:
          candidates:
            - profile: exo-api
              evaluator: Cranium.Plugins.Ensemble.Evaluators.Always
            - profile: exo-local
              evaluator: Cranium.Plugins.Ensemble.Evaluators.TurnGated
              evaluator_config:
                threshold: 5

  # Tiamat-routed: delegates model selection to Tiamat's Thompson Sampling
  # endpoint. Maps Tiamat arm IDs to local cranium profiles.
  exo-routed:
    backend: anthropic
    model: claude-opus-4-6
    identity: /path/to/identity.md
    plugins:
      - module: Cranium.Plugins.TiamatRouter
        config:
          endpoint: http://tiamat.local:8900
          timeout: 3000
          recent_turns: 5
          interactive: true
          arm_profiles:
            opus-api: exo-api
            sonnet-api: exo-sonnet
            gpt-sub: exo-gpt
            qwen-local: exo-local

  # OpenAI-compatible endpoint (llama.cpp, vLLM, etc.)
  qwen-local:
    backend: openai_compat
    model: qwen3.6-27b
    identity: /path/to/identity.md
    thinking: false
    context_window: 200000
    backend_config:
      endpoint: https://llama.gisi.network/v1
      api_key: sk-xxx
      # thinking_mode: prefill   # Qwen3.6: use </think> prefill to disable thinking

  code:
    backend: ollama
    model: gemma4-cranium
    # no identity — bare coding assistant

# Room-level profile defaults. If the client doesn't specify a profile,
# cranium checks here before falling back to the global default.
# room_defaults:
#   personal-chat: exo-ensemble
#   exo-local: exo-local
